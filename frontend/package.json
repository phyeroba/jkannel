{
  "name": "@jkannel/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "vue-tsc -b",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"tests/**/*.ts\" \"e2e/**/*.ts\" \"*.ts\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"tests/**/*.ts\" \"e2e/**/*.ts\" \"*.ts\"",
    "test": "vitest run --configLoader runner",
    "test:cov": "vitest run --configLoader runner --coverage --coverage.provider=v8 --coverage.reporter=text-summary --coverage.reporter=lcov --coverage.thresholds.statements=87 --coverage.thresholds.branches=69 --coverage.thresholds.functions=68 --coverage.thresholds.lines=87",
    "test:watch": "vitest --configLoader runner",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test:e2e": "playwright test",
    "test:visual": "playwright test --project=chrome --grep @visual"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "tailwindcss": "^4.1.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vitest/coverage-v8": "^3.2.7",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "prettier": "3.9.4",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.2.10"
  },
  "engines": {
    "node": ">=22"
  }
}
