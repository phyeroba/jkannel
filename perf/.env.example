# JKANNEL performance harness configuration.
# Copy to perf/.env and fill in. NEVER commit perf/.env (it is gitignored).
# Real values are read from the environment first; this file is only a fallback.

# --- Target ---------------------------------------------------------------
# Direct backend port (Compose) or the Wave-4 reverse proxy. Examples:
#   http://127.0.0.1:3000      (backend, default)
#   http://127.0.0.1:8080      (nginx/reverse proxy, if deployed)
PERF_BASE_URL=http://127.0.0.1:3000
PERF_API_PREFIX=/api/v1

# --- Credentials (NEVER commit real secrets) ------------------------------
PERF_TENANT=default
PERF_USERNAME=operator
# Operator password — set this in your shell or in perf/.env, never in git.
PERF_PASSWORD=

# --- Load shape -----------------------------------------------------------
# Virtual users (concurrency).
PERF_VUS=10
# Duration: 30s / 5m / 2h.
PERF_DURATION=30s
# Optional target aggregate arrival rate (req/s). 0 or unset = closed-loop
# (VUs fire as fast as they can — maximum throughput).
PERF_RPS=0
# Optional discarded warmup window before metrics are recorded.
PERF_WARMUP=0
# Per-VU think time between iterations (ms), only when unpaced.
PERF_THINK_MS=0

# --- SLO gating -----------------------------------------------------------
# local = pragmatic single-node ceilings (default).
# spec  = strict values from the Performance & Scalability spec, Section 6.
PERF_SLO_PROFILE=local
# Individual overrides (ms) — optional:
# PERF_SLO_AUTH_P95_MS=750
# PERF_SLO_REPORTING_P95_MS=800
# PERF_SLO_GRID_P95_MS=2000
# PERF_SLO_ROUTE_P95_MS=500
# PERF_SLO_ERROR_RATE=0.01
# PERF_SLO_SOAK_RSS_GROWTH=0.25

# --- Write scenario safety gate -------------------------------------------
# false (default): write-send uses the non-destructive /routes/simulate path.
# true: write-send POSTs real jobs to /bulk-send. Use ONLY on a disposable env.
PERF_ALLOW_SEND=false
