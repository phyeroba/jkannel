NODE_ENV=development
BACKEND_PORT=3000
FRONTEND_PORT=5173
POSTGRES_DB=jkannel
POSTGRES_USER=jkannel
POSTGRES_PASSWORD=replace-with-a-local-development-password
# Password for the non-owner application role (jkannel_app); required so the
# API is subject to row level security. The migration runner enables the role.
POSTGRES_APP_PASSWORD=replace-with-a-different-development-password
# Password for the authentication role (jkannel_auth); it bypasses RLS for
# pre-authentication identity lookups but only sees identity tables.
POSTGRES_AUTH_PASSWORD=replace-with-a-third-development-password
REDIS_PORT=6379
# Reverse proxy (nginx) — single HTTP entrypoint in front of frontend + backend.
# Published on the host; nginx listens on 8080/8443 inside the (non-root) container.
PROXY_HTTP_PORT=8080
PROXY_HTTPS_PORT=8443
# Separate signing keys for access and refresh tokens (at least 32 bytes each).
AUTH_ACCESS_TOKEN_KEY=replace-with-at-least-32-random-bytes-a
AUTH_REFRESH_TOKEN_KEY=replace-with-at-least-32-random-bytes-r
# Deprecated: single shared key, used only when the two keys above are unset.
AUTH_SIGNING_KEY=
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:15174,http://127.0.0.1:15174
KAMEX_ADMIN_PORT=13000
KAMEX_SENDSMS_PORT=13013
KAMEX_ADMIN_PASSWORD=replace-with-a-random-admin-password
KAMEX_STATUS_PASSWORD=replace-with-a-random-status-password
KAMEX_SENDSMS_PASSWORD=replace-with-a-random-sendsms-password
KAMEX_VALIDATOR_TOKEN=replace-with-at-least-32-random-bytes
# SQLBox uses the PostgreSQL values above. Override only when it is hosted separately.
KAMEX_SQLBOX_DATABASE_URL=postgresql://jkannel:replace-with-a-local-development-password@postgres:5432/jkannel
SQLBOX_RETENTION_DAYS=90
SQLBOX_EXPORT_MAX_ROWS=5000
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-a-random-grafana-password
# Centralized logging (compose --profile observability): Loki + Promtail.
LOKI_PORT=3100
# Watchdog (compose --profile watchdog): interval, in seconds, between
# unhealthy-container sweeps.
WATCHDOG_INTERVAL=30
# --- Optional dedicated scheduler/backup workers (compose --profile workers) ---
# The report + backup schedulers run IN-PROCESS in the backend by default.
# To run them as dedicated 'scheduler'/'backup-service' containers instead,
# enable the 'workers' profile AND turn the in-process schedulers off on the
# backend below so reports are not generated twice (the backup scheduler is
# advisory-locked and safe either way):
#   REPORT_JOBS_ENABLED=false
#   BACKUP_SCHEDULER_ENABLED=false
AI_OPERATIONS_ENABLED=false
# Optional SMTP for email notification channels (reports/alerts). When unset,
# email channels report an honest "unavailable" delivery status.
SMTP_URL=
SMTP_FROM=jkannel@localhost
# Optional external AI provider for the Ops Copilot. Default is local-only.
# AI_PROVIDER=anthropic enables Claude-backed answers; requires ANTHROPIC_API_KEY.
AI_PROVIDER=local
ANTHROPIC_API_KEY=
AI_COPILOT_MODEL=claude-sonnet-5
# Scheduled report/anomaly job cadence. Set REPORT_JOBS_ENABLED=false to disable.
REPORT_JOBS_ENABLED=true
REPORT_JOBS_INTERVAL_MS=900000
# Backup & DR (real pg_dump artifacts, encrypted at rest). Keys fall back to an
# auth key when unset; set dedicated 32+ byte keys in production.
BACKUP_ENCRYPTION_KEY=
BACKUP_SCHEDULER_ENABLED=true
BACKUP_SCHEDULER_INTERVAL_MS=3600000
# TOTP MFA secret encryption key (32+ bytes; falls back to an auth key).
MFA_ENCRYPTION_KEY=
# --- High Availability / DR (compose --profile ha, docker-compose.ha.yml) -----
# These only apply to the additive HA overlay; the single-node stack ignores them.
# See infrastructure/ha/README.md for topology, launch, and failover runbooks.
#
# PostgreSQL streaming replication: dedicated physical-replication role used by
# the standby's pg_basebackup. REPLICATION_PASSWORD is required when the ha
# profile is up; the user/slot names have safe defaults.
REPLICATION_USER=replicator
REPLICATION_PASSWORD=replace-with-a-replication-password
REPLICATION_SLOT=standby_slot
# HA reverse proxy host port (load-balances backend + backend-replica). Kept off
# 8080 so it never collides with the live single-node reverse-proxy.
PROXY_HA_HTTP_PORT=8090
#
# Sentinel-aware Redis client. When REDIS_SENTINELS is set (comma-separated
# host:port list), the backend connects through Redis Sentinel and follows the
# monitored master group named by REDIS_MASTER_NAME, so it tracks automatic
# master failover from the HA overlay. Leave REDIS_SENTINELS unset for the
# single-node stack, which uses REDIS_URL as before.
# REDIS_SENTINELS=redis-sentinel-1:26379,redis-sentinel-2:26379,redis-sentinel-3:26379
REDIS_MASTER_NAME=mymaster
#
# --- Idempotency ---------------------------------------------------------------
# How long (ms) an Idempotency-Key may sit mid-request before it is presumed
# abandoned (handler process crashed) and a retry may reclaim it. Default 60000.
# IDEMPOTENCY_STALE_MS=60000
