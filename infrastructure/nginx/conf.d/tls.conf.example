# Optional HTTPS entrypoint for the JKANNEL reverse proxy.
#
# nginx only auto-includes files matching *.conf, so this .example file is
# INERT until you enable it. To turn on TLS:
#
#   1. Generate a self-signed dev certificate:
#        bash infrastructure/nginx/generate-dev-certs.sh
#      (for production, drop your real cert/key into infrastructure/nginx/certs/
#       as jkannel.crt / jkannel.key, or mount them from your secret store.)
#   2. Copy this file next to jkannel.conf with a .conf extension:
#        cp infrastructure/nginx/conf.d/tls.conf.example \
#           infrastructure/nginx/conf.d/tls.conf
#   3. Publish the HTTPS port by uncommenting the 8443 mapping on the
#      reverse-proxy service in docker-compose.yml (${PROXY_HTTPS_PORT}:8443).
#   4. docker compose up -d reverse-proxy
#
# Certs are gitignored (infrastructure/nginx/certs/*), so they are never
# committed.

server {
    listen 8443 ssl;
    http2 on;
    server_name _;

    ssl_certificate     /etc/nginx/certs/jkannel.crt;
    ssl_certificate_key /etc/nginx/certs/jkannel.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 10m;

    client_max_body_size 25m;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location /api/ {
        proxy_pass http://jkannel_backend;
    }

    location / {
        proxy_pass http://jkannel_frontend;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
    }
}
