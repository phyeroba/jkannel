{
  "uid": "jkannel-sms-operations",
  "title": "JKANNEL SMS Operations",
  "description": "Carrier bind health, queue depth, throughput and failures for the Kamex/Kannel bearerbox, sourced from the backend's SmscStatusPoller. Every series here is about SMS traffic; process-level Node/DB/Redis health lives on the JKANNEL Platform Health dashboard.",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "tags": ["jkannel", "kamex", "sms", "smsc"],
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "smsc",
        "label": "SMSC bind",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "jkannel-prometheus" },
        "query": "label_values(jkannel_smsc_bind_up, smsc)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Bind health",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Engine reachable",
      "description": "0 means the backend could not read bearerbox /status.json on its last poll. This is a real observation, not an assumption: when the engine cannot be read, no per-bind series is published at all.",
      "datasource": { "type": "prometheus", "uid": "jkannel-prometheus" },
      "targets": [{ "expr": "jkannel_engine_up", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red", "index": 0 } } },
            { "type": "value", "options": { "1": { "text": "UP", "color": "green", "index": 1 } } }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none" },
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Binds bound",
      "description": "Binds in the normalised 'bound' state out of all binds the engine knows about.",
      "datasource": { "type": "prometheus", "uid": "jkannel-prometheus" },
      "targets": [
        { "expr": "jkannel_engine_binds_bound", "refId": "A", "legendFormat": "bound" },
        { "expr": "jkannel_engine_binds", "refId": "B", "legendFormat": "total" }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "options": { "colorMode": "value", "graphMode": "area" },
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 1 }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Snapshot age",
      "description": "Seconds since the cached bearerbox snapshot that /metrics is served from was taken. A rising value means the poller has stopped, so every other panel on this dashboard is stale.",
      "datasource": { "type": "prometheus", "uid": "jkannel-prometheus" },
      "targets": [{ "expr": "jkannel_engine_snapshot_age_seconds", "refId": "A" }],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 90 },
              { "color": "red", "value": 300 }
            ]
          }
        }
      },
      "options": { "colorMode": "background", "graphMode": "none" },
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 1 }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Bind state per SMSC",
      "description": "1 = bound, 0 = anything else. The 'state' label carries the normalised Ch.22 state (connecting / binding / bound / unbinding / disconnected / retrying / failed / unknown).",
      "datasource": { "type": "prometheus", "uid": "jkannel-prometheus" },
      "targets": [
        {
          "expr": "jkannel_smsc_bind_up{smsc=~\"$smsc\"}",
          "refId": "A",
          "legendFormat": "{{smsc}} ({{state}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "custom": { "drawStyle": "line", "lineInterpolation": "stepAfter", "fillOpacity": 20 }
        }
      },
      "gridPos": { "h": 5, "w": 12, "x": 12, "y": 1 }
    },
    {
      "id": 200,
      "type": "row",
      "title": "Queues",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 6 }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Queue depth per SMSC",
      "description": "Messages waiting on each carrier bind. This is the metric an operator most often writes an alert rule against (metric name in the console: smsc.queued).",
      "datasource": { "type": "prometheus", "uid": "jkannel-prometheus" },
      "targets": [
        {
          "expr": "jkannel_smsc_queued{smsc=~\"$smsc\"}",
          "refId": "A",
          "legendFormat": "{{smsc}}"
        }
      ],
      "fieldConfig": { "defaults": { "min": 0, "custom": { "fillOpacity": 10 } } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 7 }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Engine-wide queues",
      "description": "Bearerbox's own outbound/inbound SMS queues and its pending DLR queue. jkannel_engine_store_size is absent (not zero) whenever the engine reports the store size as unknown.",
      "datasource": { "type": "prometheus", "uid": "jkannel-prometheus" },
      "targets": [
        {
          "expr": "jkannel_engine_sms_queued",
          "refId": "A",
          "legendFormat": "sms {{direction}}"
        },
        { "expr": "jkannel_engine_dlr_queued", "refId": "B", "legendFormat": "dlr" },
        { "expr": "jkannel_engine_store_size", "refId": "C", "legendFormat": "store" }
      ],
      "fieldConfig": { "defaults": { "min": 0, "custom": { "fillOpacity": 10 } } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 7 }
    },
    {
      "id": 300,
      "type": "row",
      "title": "Throughput and failures",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 15 }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Throughput (engine-reported, 1m window)",
      "description": "SMS/sec as bearerbox itself computes it over its 1-minute window, per bind and direction.",
      "datasource": { "type": "prometheus", "uid": "jkannel-prometheus" },
      "targets": [
        {
          "expr": "jkannel_smsc_throughput_messages_per_second{smsc=~\"$smsc\",window=\"1m\"}",
          "refId": "A",
          "legendFormat": "{{smsc}} {{direction}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "MT / MO rate (derived from counters)",
      "description": "rate() over the cumulative per-bind sent/received counters. Cross-checks the engine's own rate figures and survives a bearerbox restart as a counter reset.",
      "datasource": { "type": "prometheus", "uid": "jkannel-prometheus" },
      "targets": [
        {
          "expr": "rate(jkannel_smsc_messages_total{smsc=~\"$smsc\"}[5m])",
          "refId": "A",
          "legendFormat": "{{smsc}} {{direction}}"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Failures per SMSC (5m increase)",
      "description": "Growth in bearerbox's own per-bind failure counter. The poller alerts separately on a jump here, because a bind can stay nominally bound while the carrier rejects everything.",
      "datasource": { "type": "prometheus", "uid": "jkannel-prometheus" },
      "targets": [
        {
          "expr": "increase(jkannel_smsc_failed_total{smsc=~\"$smsc\"}[5m])",
          "refId": "A",
          "legendFormat": "{{smsc}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "custom": { "drawStyle": "bars", "fillOpacity": 60 },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 10 }
            ]
          }
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Delivery reports pending",
      "description": "Depth of the engine's DLR queue. Per-outcome delivery classification (DELIVRD / EXPIRED / UNDELIV / REJECTD) is not exported yet: DLR masks are not decoded on ingest, so this panel shows DLR flow, not delivery success. Do not read it as a success rate.",
      "datasource": { "type": "prometheus", "uid": "jkannel-prometheus" },
      "targets": [
        { "expr": "jkannel_engine_dlr_queued", "refId": "A", "legendFormat": "dlr queued" },
        {
          "expr": "rate(jkannel_smsc_messages_total{direction=\"received\",smsc=~\"$smsc\"}[5m])",
          "refId": "B",
          "legendFormat": "{{smsc}} inbound rate"
        }
      ],
      "fieldConfig": { "defaults": { "min": 0 } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 }
    }
  ]
}
