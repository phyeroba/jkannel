.env
.env.*
!.env.example
node_modules/
dist/
coverage/
.vite/
.cache/
*.tsbuildinfo
artifacts/
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/
.claude/settings.local.json
# Local archives / snapshots (may contain secrets) — never publish
*.zip
*.tar
*.tar.gz
*.tgz
# TLS certificates for the reverse proxy (never publish private keys)
infrastructure/nginx/certs/*.crt
infrastructure/nginx/certs/*.key
infrastructure/nginx/certs/*.pem
# ACME http-01 challenge tokens written by certbot/lego/acme.sh (ephemeral).
infrastructure/nginx/acme/*
!infrastructure/nginx/acme/.gitkeep
# Backup artifacts (full database dumps — contain all data, never publish)
runtime/**/backups/
*.dump
*.dump.enc
*.pgdump
*.backup

# Playwright MCP scratch output (browser snapshots/screenshots)
.playwright-mcp/

# ---------------------------------------------------------------------------
# PER-DEPLOYMENT CONFIGURATION — NEVER COMMITTED
#
# Every deployment differs: our test server, each developer's own box, whatever
# production becomes. Ports, hostnames and bind topology are properties of a
# HOST, not of the product, so none of them belong in the repository.
#
# `docker-compose.override.yml` is the dangerous one, because Compose AUTO-LOADS
# it. Committing ours would silently impose our server's port map and its
# fakesmsc test bind on every developer who pulls — they would not even see it
# happen. It was briefly committed; this is the correction.
#
#   deploy/<host>/     the real files for a specific machine (git-ignored)
#   docker-compose.override.example.yml   the committed, documented template
#   scripts/deploy-config.ps1             ships deploy/<host>/ to that host
# ---------------------------------------------------------------------------
docker-compose.override.yml
deploy/

# Playwright run artefacts (traces, videos, failure screenshots).
e2e/test-results/
test-results/

# Throwaway capture scripts copied into e2e/ so they resolve @playwright/test.
e2e/*.tmp.mjs
